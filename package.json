{
  "name": "dsh-pi-bridge",
  "version": "0.2.0",
  "type": "module",
  "description": "One plugin, two hosts: installs into the pi coding agent and into DeepSeek Harness, and bridges the ecosystems. In DSH a pi_install tool turns pi packages into native DSH tools, commands and skills; in pi a /dsh-install command turns DSH plugin bundles into pi tools and commands. Same code, both entry conventions, published on npm so both plugin markets find it.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/run-all.mjs",
    "test:offline": "node scripts/selftest.mjs && node scripts/entry-check.mjs",
    "test:proxy": "node daemon/acceptance.mjs && node daemon/dsh-proxy-e2e.mjs && node daemon/dsh-host-e2e.mjs && node daemon/proxy-e2e.mjs",
    "test:host": "node tools/realhost-check.mjs",
    "test:network": "node tools/e2e-preview.mjs && node tools/edge-cases.mjs",
    "e2e": "node tools/e2e-preview.mjs && node tools/edge-cases.mjs",
    "test:live": "node daemon/acceptance.mjs --live",
    "test:dsh-live": "node daemon/dsh-real-host.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pi",
    "pi-package",
    "pi-extension",
    "bridge",
    "compatibility",
    "cross-host",
    "plugin-loader"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "index.js",
    "src/*.js",
    "extensions/index.js",
    "skills/dsh-pi-bridge/SKILL.md",
    "daemon/run.mjs",
    "daemon/bootstrap.js",
    "scripts/selftest.mjs",
    "scripts/entry-check.mjs",
    "scripts/run-all.mjs",
    "scripts/loader-unit.mjs",
    "tools/selfhost-check.mjs",
    "tools/realhost-check.mjs",
    "tools/e2e-preview.mjs",
    "tools/edge-cases.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "daemon/dsh-host-e2e.mjs",
    "daemon/acceptance.mjs",
    "daemon/dsh-proxy-e2e.mjs",
    "daemon/proxy-e2e.mjs",
    "daemon/dsh-real-host.mjs"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twofruitsgrape/dsh-pi-bridge.git"
  },
  "homepage": "https://github.com/Twofruitsgrape/dsh-pi-bridge",
  "bugs": {
    "url": "https://github.com/Twofruitsgrape/dsh-pi-bridge/issues"
  }
}
